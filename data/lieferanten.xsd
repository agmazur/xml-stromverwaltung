<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">

    <xs:element name="lieferanten">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="lieferant" minOccurs="0" maxOccurs="unbounded">
                    <xs:complexType>
                        <xs:sequence>
                            <xs:element name="region">
                                <xs:simpleType>
                                    <xs:restriction base="xs:string">
                                        <xs:enumeration value="Région lémanique"/>
                                        <xs:enumeration value="Espace Mittelland"/>
                                        <xs:enumeration value="Nordwestschweiz"/>
                                        <xs:enumeration value="Zürich"/>
                                        <xs:enumeration value="Ostschweiz"/>
                                        <xs:enumeration value="Zentralschweiz"/>
                                        <xs:enumeration value="Ticino"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="password">
                                <xs:simpleType>
                                    <xs:restriction base="xs:string">
                                        <xs:length value="10"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="type">
                                <xs:simpleType>
                                    <xs:restriction base="xs:string">
                                        <xs:enumeration value="strom"/>
                                        <xs:enumeration value="gas"/>
                                        <xs:enumeration value="solar"/>
                                        <xs:enumeration value="mixed"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="date" type="xs:date"/>
                            <xs:element name="price" type="xs:float"/>
                        </xs:sequence>
                    </xs:complexType>
                </xs:element>
            </xs:sequence>
        </xs:complexType>
    </xs:element>

</xs:schema>